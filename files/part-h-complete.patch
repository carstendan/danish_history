+MIXED = "#9AA39B"
+
+
+def esc(s):
+    return s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
+
+
+# ====================================================================== figure 1
+# Each column: (heading, rule, [steps]). A step of None is a deliberate gap.
+COLS = [
